# ========================================================
# Project-Specific Exclusions / Projeye Özel Hariç Tutulanlar
# ========================================================

# 1. Backups & Backup Directories / Yedekler ve Yedek Klasörleri
backups/
**/backups/
*.bak

# 2. User & Local Configuration / Kullanıcı ve Yerel Ayar Dosyaları
settings.json
**/settings.json

# 3. Local Build Script / Yerel Derleme Betiği
compile.bat
**/compile.bat

# 4. Compiled Binaries & Build Output / Derlenmiş İkili (.exe) ve Çıktı Dosyaları
*.exe
*.dll
*.pdb

# ========================================================
# Windows & System Artifacts / Windows ve Sistem Kalıntıları
# ========================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

*.tmp
*.log

# ========================================================
# IDE & Compiler Artifacts / IDE ve Derleyici Kalıntıları
# ========================================================
.vs/
.vscode/
bin/
obj/
*.suo
*.user
